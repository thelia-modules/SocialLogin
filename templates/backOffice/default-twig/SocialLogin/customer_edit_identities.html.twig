<div class="d-flex flex-wrap gap-2 mb-3" data-testid="sociallogin-customer-identities">
    {% for identity in identities %}
        <span class="badge text-bg-light border" data-testid="sociallogin-customer-identity-{{ identity.provider }}">
            <i class="bi bi-link-45deg" aria-hidden="true"></i>
            {# providerLabels comes from the registry, through CustomerEditHook: a provider
               removed since the identity was created falls back to its raw code. #}
            {% set providerLabel = (providerLabels[identity.provider]|default(identity.provider|capitalize))|trans({}, 'sociallogin.bo.default-twig') %}
            {% if identity.lastLoginAt %}
                {{ 'Linked account: %provider% (%email%), last login on %date%'|trans({
                    '%provider%': providerLabel,
                    '%email%': identity.email,
                    '%date%': identity.lastLoginAt|date('d/m/Y H:i'),
                }, 'sociallogin.bo.default-twig') }}
            {% else %}
                {{ 'Linked account: %provider% (%email%)'|trans({
                    '%provider%': providerLabel,
                    '%email%': identity.email,
                }, 'sociallogin.bo.default-twig') }}
            {% endif %}
        </span>
    {% endfor %}
</div>
