{% extends 'base.html.twig' %}

{% block title %}{{ 'Link your account'|trans({}, 'sociallogin') }}{% endblock %}

{% block body %}
    {% set form = getForm('sociallogin_front_attach_password_form') %}
    {% form_theme form with flexy_form_themes only %}

    <div class="container-s pt-8 pb-14 lg:pt-12 lg:pb-30">
        {% for error in form.vars.errors %}
            <twig:Molecules:SnackBar:Base variant="error" text="{{ error.message }}" />
        {% endfor %}

        <h2 class="h2 text-black mb-4">{{ 'Link your account'|trans({}, 'sociallogin') }}</h2>
        <p class="paragraph-2 text-black mb-8">
            {{ 'An account already exists for %email%. Enter its password to link this sign-in method to it.'|trans({'%email%': pendingEmail}, 'sociallogin') }}
        </p>

        {{ form_start(form, {attr: {
            action: path('sociallogin_attach_submit'),
            method: 'POST',
            class: 'flex flex-col gap-6 mb-3',
        }}) }}
        {{ form_row(form.success_url, {value: path('account_index')}) }}
        {{ form_row(form.error_url, {value: path('sociallogin_attach')}) }}
        {{ form_row(form.password, {label: 'Password'|trans, placeholder: 'Your password'|trans}) }}

        <div class="flex flex-col gap-6">
            <twig:Molecules:Link:Base href="{{ path('password_forgotten') }}" customText="{{ 'Forgot password?'|trans }}" />
            <twig:Molecules:Button:Base text="{{ 'Link account'|trans({}, 'sociallogin') }}" type="submit" class="w-max" />
        </div>
        {{ form_end(form) }}

        <hr class="my-10 text-grey" />

        <form method="post" action="{{ path('sociallogin_attach_cancel') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('sociallogin_attach_cancel') }}">
            <twig:Molecules:Button:Base text="{{ 'Cancel'|trans }}" type="submit" color="minimal" class="w-max" />
        </form>
    </div>
{% endblock %}
